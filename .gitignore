node_modules/
__pycache__/
*.py[cod]
.cache/

# Credentials — config.json holds a live session cookie. Never commit it.
/config.json
/.env
/.env.*
!/.env.example

# Runtime state and caches
cache/
run/
scratch/

# Local clone of the UltiMafia server source, used only for reference
um-src/

# game archive and generated training data
/mafia.db
/mafia.db-*
/data/*.jsonl
/data/*.zip
/data/**/*.jsonl
/data/**/*.zip

# Fine-tuning artifacts are large and may contain memorized training text.
/training-output/
/checkpoints/
/wandb/
*.safetensors
*.gguf
